# GoRento backend — copy to .env and fill secrets (do not commit .env)

# PayOS — https://my.payos.vn
PAYOS_MODE=mock
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
PAYOS_RETURN_URL=http://localhost:8080/api/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:8080/api/payments/payos/cancel
PAYOS_FRONTEND_URL=http://localhost:49457/#/bookings

# VNPay sandbox (optional / legacy)
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VNPAY_FRONTEND_URL=http://localhost:49457/#/bookings

# Goong Maps
GOONG_API_KEY=YOUR_GOONG_API_KEY

# SePay (optional / legacy)
SEPAY_MODE=mock
SEPAY_BANK_BIN=970422
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_ACCOUNT_NAME=CONG TY GORENTO
SEPAY_WEBHOOK_API_KEY=

# Gemini (chatbot tìm xe) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
